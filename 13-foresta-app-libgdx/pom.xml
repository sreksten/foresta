<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.threeamigos</groupId>
        <artifactId>foresta</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>13-foresta-app-libgdx</artifactId>
    <name>13-foresta-app-libgdx</name>
    <description>L'applicazione desktop (Windows, Linux, macOS) con l'interfaccia libGDX: il punto d'ingresso; Android e iOS hanno il loro, fuori da Maven</description>

    <dependencies>
        <dependency>
            <groupId>com.threeamigos</groupId>
            <artifactId>12-foresta-libgdx</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.badlogicgames.gdx</groupId>
            <artifactId>gdx-backend-lwjgl3</artifactId>
            <version>${libgdx.version}</version>
        </dependency>
        <dependency>
            <groupId>com.badlogicgames.gdx</groupId>
            <artifactId>gdx-platform</artifactId>
            <version>${libgdx.version}</version>
            <classifier>natives-desktop</classifier>
        </dependency>
    </dependencies>

    <build>
        <finalName>foresta-libgdx-${project.version}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>2.4</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.threeamigos.foresta.MainLibgdx</mainClass>
                        </manifest>
                    </archive>
                    <outputDirectory>${maven.multiModuleProjectDirectory}</outputDirectory>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-assembly-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.threeamigos.foresta.MainLibgdx</mainClass>
                        </manifest>
                    </archive>
                    <outputDirectory>${maven.multiModuleProjectDirectory}</outputDirectory>
                    <descriptorRefs>
                        <descriptorRef>jar-with-dependencies</descriptorRef>
                    </descriptorRefs>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
