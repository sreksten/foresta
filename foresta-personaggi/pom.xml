<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.threeamigos</groupId>
        <artifactId>foresta</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>foresta-personaggi</artifactId>
    <name>foresta-personaggi</name>
    <description>I personaggi, i gruppi di personaggi e il combattimento fra gruppi: chi sono, che cosa possiedono e come si scontrano, con i loro tipi, i loro dati e i loro contratti per la UI; niente su dove vivono o su chi li comanda</description>

    <dependencies>
        <dependency>
            <groupId>com.threeamigos</groupId>
            <artifactId>foresta-tipi</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.threeamigos</groupId>
            <artifactId>foresta-mappa</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.threeamigos</groupId>
            <artifactId>foresta-artefatti</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.threeamigos</groupId>
            <artifactId>foresta-eventi</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.threeamigos</groupId>
            <artifactId>foresta-danni</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.threeamigos</groupId>
            <artifactId>foresta-effettidistato</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.threeamigos</groupId>
            <artifactId>foresta-attributi</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.threeamigos</groupId>
            <artifactId>foresta-testi</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.threeamigos</groupId>
            <artifactId>foresta-strumenti</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.threeamigos</groupId>
            <artifactId>foresta-serializzazione</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>


    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>2.4</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
