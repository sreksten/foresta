<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.threeamigos</groupId>
    <artifactId>foresta</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>La Foresta</name>
    <description>La Foresta by Gundam of 3AM: pom padre dei moduli (vedi foresta.md per la loro mappa)</description>
    <packaging>pom</packaging>

    <!-- Dall'alto verso il basso nell'ordine di dipendenza: ogni modulo conosce solo quelli sopra di lui -->
    <modules>
        <module>foresta-strumenti</module>
        <module>foresta-eventi</module>
        <module>foresta-testi</module>
        <module>foresta-comandi</module>
        <module>foresta-serializzazione</module>
        <module>foresta-attributi</module>
        <module>foresta-effettidistato</module>
        <module>foresta-danni</module>
        <module>foresta-artefatti</module>
        <module>foresta-mappa</module>
        <module>foresta-personaggi</module>
        <module>foresta-poteri</module>
        <module>foresta-combattimento</module>
        <module>foresta-tattiche</module>
        <module>foresta-statistiche</module>
        <module>foresta-intermezzi</module>
        <module>foresta-bottino</module>
        <module>foresta-mondo</module>
        <module>foresta-economia</module>
        <module>foresta-missioni</module>
        <module>foresta-bestiario</module>
        <module>foresta-trofei</module>
        <module>foresta-modellodati</module>
        <module>foresta-motore-api</module>
        <module>foresta-motore</module>
        <module>foresta-swing</module>
        <module>foresta-app</module>
    </modules>

    <properties>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.11</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
